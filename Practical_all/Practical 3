<!DOCTYPE html>
<html>
<head>
    <title>Student Grading System</title>
</head>
<body>

    <h2>Tabish's Student Grading System (24070521203)</h2>

    Enter Marks:
    <input type="number" id="marks">

    <button onclick="checkGrade()">Submit</button>

    <p id="result"></p>

    <script>
        function checkGrade() {

            var marks = document.getElementById("marks").value;

            if (marks == "") {
                alert("Please Enter Marks.");
                return;
            }

            if (marks < 0 || marks > 100) {
                alert("Enter marks between 0 and 100");
                return;
            }

            let grade;

            if (marks >= 90)
                grade = "A";
            else if (marks >= 75)
                grade = "B";
            else if (marks >= 60)
                grade = "C";
            else if (marks >= 40)
                grade = "D";
            else
                grade = "Fail";

            document.getElementById("result").innerHTML =
                "Marks = " + marks + "<br>Grade = " + grade;
        }
    </script>

</body>
</html>
